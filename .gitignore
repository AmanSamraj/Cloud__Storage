# .gitignore
# Node modules
node_modules/

# Build output
frontend/dist/
backend/dist/

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files (keep secrets out of repo)
*.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db

# IDE / editor files
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# Antigravity temporary/artifact folder
*.gemini/